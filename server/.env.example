# --- Runtime ---
# In prod set NODE_ENV=production. The server refuses to start if
# JWT_SECRET or CLIENT_ORIGIN are missing / defaulted when NODE_ENV=production.
NODE_ENV=development
PORT=3001

# --- Auth ---
# Generate a strong random value for prod, e.g.  `openssl rand -base64 48`.
JWT_SECRET=change-me-in-production-please

# --- CORS ---
# Prod: set to the Netlify frontend URL, e.g. https://kidsbrain.netlify.app
CLIENT_ORIGIN=http://localhost:5173

# --- Database ---
# On Render, mount a persistent disk at /var/data and set DB_PATH=/var/data/kidsbrain.sqlite.
# For a future Postgres port, swap for DATABASE_URL instead (see README).
DB_PATH=./db/kidsbrain.sqlite

# --- First-run seed ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Seed value for each client's parent PIN. Rotate immediately per client in the console.
DEFAULT_PARENT_PIN=1234
